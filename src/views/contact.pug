        li.mb-2
          span.icon-text
            span.icon
              i.fas.fa-envelope
            a(href='mailto:trumbull.j@gmail.com') trumbull.j@gmail.com
        li.mb-2
          span.icon-text
            span.icon
              i.fab.fa-github
            a(href='mailto:trumbull.j@gmail.com') GitHub profile
        li.mb-2
          span.icon-text
            span.icon
              i.fab.fa-stack-overflow
