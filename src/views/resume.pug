//- ---------------------------------------------------------------------------
//- Pug: About
//- ---------------------------------------------------------------------------

extends layout

block content
  div.container
    div.section
      h1.title Summary
      p #{summary}
    
    div.section.pt-1
      h1.title Work History

      each item in history
        - var start = new Date(item.start)
        - var startMonth = start.getMonth() + 1
        - var startYear = start.getFullYear()
        - var end = new Date(item.end)
        - var endMonth = end.getMonth() + 1
        - var endYear = end.getFullYear()
        div.work-history-item.mt-5
          p.title.is-4= item.title
          div.is-flex.is-align-items-baseline.is-flex-direction-row
            p.subtitle.mr-3.mt-3= item.company
            p= `${startMonth.toString().padStart(2, '0')}/${startYear} - ${endMonth.toString().padStart(2, '0')}/${endYear}`
          if item.summary
            p
              strong Summary: 
              | #{item.summary}
          if item.achievements && item.achievements.length > 0
            div.content
              ul.mt-3
                each achievement in item.achievements
                  li= achievement
    
    div.section.pt-1
      h1.title Technical Skills
      .content 
        ul.mt-4
          li <strong>Languages</strong>: C#, TypeScript, JavaScript, PHP, SQL
          li <strong>Frontend</strong>: HTML, CSS, Sass, React, Angular
          li <strong>Backend</strong>: .NET Core, Node.js, REST APIs
          li <strong>Databases</strong>: MS SQL Server, PostgreSQL, MySQL, MongoDB
          li <strong>Tools</strong>: Git, Docker, Azure DevOps, GitLab
          li <strong>Methodologies</strong>: Agile, Scrum, TDD, CI/CD